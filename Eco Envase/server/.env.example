PORT=5000

# OPCIÓN 1 (Recomendada con Supabase): Usar la Connection String completa (URI)
# En Supabase Dashboard: botón "Connect" (arriba) o Project Settings -> Database -> Connection String -> URI
# Reemplaza [TU-PASSWORD] con tu contraseña real de PostgreSQL
# DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[TU-PROYECTO-ID].supabase.co:5432/postgres

# OPCIÓN 2: Usar variables individuales
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres
